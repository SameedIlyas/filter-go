# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# development | production. If you forget it we assume production (strict checks on).
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database (docker compose up gives you this one)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://filter:filter@localhost:5433/filter_portal

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Public URL of the portal. Used to build the links inside invite / reset emails.
FRONTEND_URL=http://localhost:3000

# Browser origins allowed to call this API directly (comma separated).
# Leave EMPTY when only the Next.js server talks to this API (recommended).
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------
# Who is allowed to tell us the real client IP via X-Forwarded-For.
#   false        -> trust nobody (default, safest, use when nothing sits in front)
#   1            -> trust exactly one proxy hop
#   10.0.0.0/8   -> trust proxies in these CIDRs (comma separated)
# The Next.js server sits in front of this API, so set this to its address
# in every deployed environment, otherwise every user shares one IP for rate limits.
TRUST_PROXY=false

# Shared secret between the Next.js server and this API. The Next.js server sends it as
# the X-Service-Key header on EVERY request; requests without it get 403 INVALID_SERVICE_KEY.
# Generate one: openssl rand -base64 48   (min 32 chars). Required in production.
# Leave empty in local development if you like.
SERVICE_API_KEY=

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
# Idle timeout: session dies after this long without a request.
SESSION_IDLE_SECONDS=28800          # 8 hours
SESSION_ABSOLUTE_SECONDS=86400      # 24 hours, hard cap even if active
# Same two limits when the user ticked "Remember me".
SESSION_REMEMBER_IDLE_SECONDS=2592000       # 30 days
SESSION_REMEMBER_ABSOLUTE_SECONDS=7776000   # 90 days
# Max active sessions per user. Oldest is revoked when exceeded.
SESSION_MAX_PER_USER=10

# -----------------------------------------------------------------------------
# One-time links
# -----------------------------------------------------------------------------
INVITE_TTL_SECONDS=259200           # 72 hours
PASSWORD_RESET_TTL_SECONDS=1800     # 30 minutes

# How long audit_events rows are kept before the hourly cleanup deletes them.
AUDIT_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# Login throttling (failed attempts inside LOGIN_WINDOW_SECONDS)
# -----------------------------------------------------------------------------
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_FAILS_PER_EMAIL_IP=5
LOGIN_MAX_FAILS_PER_EMAIL=25
LOGIN_MAX_FAILS_PER_IP=50

# -----------------------------------------------------------------------------
# Background jobs, files, public forms
# -----------------------------------------------------------------------------
# Scheduled jobs (timesheet sweeps, invoice sync outbox, contract expiry). Safe with several instances.
JOBS_ENABLED=true
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
# Website origins allowed to POST to /public/leads from a browser (comma separated). Empty = server-to-server only.
PUBLIC_LEAD_ORIGINS=

# -----------------------------------------------------------------------------
# Work rules (defaults come from the system design doc)
# -----------------------------------------------------------------------------
LATE_IN_MINUTES=10
EARLY_OUT_MINUTES=10
OVERTIME_THRESHOLD_MINUTES=15
WEEKLY_OVERTIME_MINUTES=2400
GEOFENCE_METERS=300
MISSING_CLOCK_OUT_HOURS=2
NO_SHOW_MINUTES=30
CLOCK_IN_EARLY_MINUTES=60

# -----------------------------------------------------------------------------
# Integrations. Only the "fake" providers exist today (see docs/ARCHITECTURE.md, Invoices).
# -----------------------------------------------------------------------------
ACCOUNTING_PROVIDER=fake
PAYMENT_PROVIDER=fake
# Signing secret of the Stripe webhook endpoint (whsec_...). Webhooks are rejected without it.
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email. console = print to the server log (dev). smtp = real delivery.
# -----------------------------------------------------------------------------
MAIL_DRIVER=console
MAIL_FROM="FilterGO Portal <no-reply@filter-go.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
